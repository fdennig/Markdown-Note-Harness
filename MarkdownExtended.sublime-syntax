%YAML 1.2
---
name: MarkdownExtended
scope: text.html.markdown
version: 2
hidden: false
extends: Packages/Markdown/Markdown.sublime-syntax
file_extensions: [md]

contexts:
  list-blocks:
    - meta_prepend: true

    # Unchecked List Start: Push Stack [List Container, Line Logic]
    - match: ([ \t]*)([*+-])((?:[ ](\[)([ ])(\]))\s)
      captures:
        1: markup.list.unnumbered.markdown
        2: markup.list.unnumbered.bullet.markdown punctuation.definition.list_item.markdown
        3: markup.list.unnumbered.markdown
        4: markup.checkbox.begin.markdown-gfm punctuation.definition.checkbox.begin.markdown-gfm
        5: markup.checkbox.mark.markdown-gfm
        6: markup.checkbox.end.markdown-gfm punctuation.definition.checkbox.end.markdown-gfm
      push: 
        - unordered-list-block # Inherit standard list behavior
        - todo-item-unchecked  # Apply special symbol scope to this line

  list-items:
    - meta_prepend: true
    
    # Unchecked Subsequent Item: Push ONLY Line Logic (Container already active)
    - match: ([ \t]*)([*+-])((?:[ ](\[)([ ])(\]))\s)
      captures:
        1: markup.list.unnumbered.markdown
        2: markup.list.unnumbered.bullet.markdown punctuation.definition.list_item.markdown
        3: markup.list.unnumbered.markdown
        4: markup.checkbox.begin.markdown-gfm punctuation.definition.checkbox.begin.markdown-gfm
        5: markup.checkbox.mark.markdown-gfm
        6: markup.checkbox.end.markdown-gfm punctuation.definition.checkbox.end.markdown-gfm
      push: todo-item-unchecked
      
    # Note: Checked items will fall through to the standard Markdown syntax, 
    # which is exactly what you want (they won't get your symbol scope).

  todo-item-unchecked:
    # 1. Apply Symbol Scope
    - meta_scope: entity.name.tag.todo.unchecked.markdown.line
    # 2. End at newline
    - match: $
      pop: true
    # 3. CRITICAL: Allow Wikilinks/Bold/Italic inside the TODO line
    - include: scope:text.html.markdown#inlines

  

  frontmatter:
    - meta_prepend: true
    
    # YAML with explicit language tag - use custom email YAML
    - match: (---)\s*(?i:(yaml|yml)\s*)\n
      captures:
        0: meta.frontmatter.markdown
        1: punctuation.section.frontmatter.begin.markdown
        2: constant.other.language-name.markdown
      embed: scope:source.yaml.email-frontmatter
      embed_scope: meta.frontmatter.markdown source.yaml.embedded.markdown
      escape: ^(---|\.{3})\s*\n
      escape_captures:
        0: meta.frontmatter.markdown
        1: punctuation.section.frontmatter.end.markdown

    # YAML without language tag (default) - use custom email YAML
    - match: (---)\s*\n
      captures:
        0: meta.frontmatter.markdown
        1: punctuation.section.frontmatter.begin.markdown
      embed: scope:source.yaml.email-frontmatter
      embed_scope: meta.frontmatter.markdown source.yaml.embedded.markdown
      escape: ^(---|\.{3})\s*\n
      escape_captures:
        0: meta.frontmatter.markdown
        1: punctuation.section.frontmatter.end.markdown
