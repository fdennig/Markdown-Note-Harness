<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
    <key>name</key><string>Email Flag Symbols</string>
    <key>scope</key>
    <!-- Assigned in YAMLEmailFrontmatter.sublime-syntax to whole 'key: value'
         pairs, so the text reaching the transformation below is e.g.
         "toreply: true". -->
    <string>entity.name.email.flag.yaml</string>

    <key>settings</key>
    <dict>
        <!-- Indexed only: these are for project-wide lookup (ctrl+shift+R) and
             window.symbol_locations(), not the per-file symbol list. -->
        <key>showInSymbolList</key><integer>0</integer>
        <key>showInIndexedSymbolList</key><integer>1</integer>

        <!-- Rewrite each pair into its own unambiguous token. The index stores
             the TRANSFORMED name, so these are the names to look up.
             Without this the symbols would be raw values like "high" or
             "email", which can collide with identically named symbols indexed
             from other files: symbol lookup matches on name alone and offers
             no scope filter. Every pair the syntax rule matches has a line
             here; anything missing falls through under its raw text.

             The boolean flags are enumerated because their values are pinned
             in the syntax. 'class' is not: one capturing substitution turns
             any 'class: X' into 'X_note', so a class invented in a note is
             findable via window.symbol_locations("X_note") without touching
             this file. TodoSync.sublime-settings names the classes it sweeps.
             'class: email' still yields 'email_note', which francis.py's email
             commands depend on, as they do on 'toreply_note'. -->
        <key>symbolIndexTransformation</key>
        <string><![CDATA[
            s/^toreply\s*:\s*true$/toreply_note/;
            s/^personal\s*:\s*true$/personal_note/;
            s/^sent\s*:\s*true$/sent_note/;
            s/^priority\s*:\s*high$/priority_note/;
            s/^class\s*:\s*([A-Za-z0-9_-]+)$/$1_note/;
        ]]></string>
    </dict>
</dict>
</plist>
