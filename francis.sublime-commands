[
    {
      // Pick a note from the symbol index and write [[its basename]] at the
      // caret. Also on tab inside [] , and on tab inside an existing [[link]]
      // to re-pick its target.
      //
      // "/person", "/activity", "/email" ... narrow by frontmatter class and
      // union with each other; without one, every class but email is listed.
      // A note with no "class:" key produces no symbol and so is not offered
      // -- classifying it is what puts it in the list.
      //
      // Replaces MarkdownEditing's mde_make_page_reference, which answered the
      // same question by stat-ing every file in every project folder. That one
      // is still on MarkdownEditing's own palette entry.
      "caption": "Wiki: Insert link to note",
      "command": "wiki_pick_link"
    },
    {
      "caption": "Open Markdown Link",
      // "command": "prompt_add_string_to_selection",
      "command": "open_linked_file",
      
      "args"   : {}
    },
    {
      // Re-derive the overview from the notes. Runs automatically on save of
      // any markdown file; this is the manual nudge.
      "caption": "Todos: Sweep now",
      "command": "todo_sync_sweep"
    },
    {
      // Push ticks and ! toggles from the overview back into the notes.
      // Runs automatically on save of todoUNDP.md.
      "caption": "Todos: Apply overview edits",
      "command": "todo_sync_apply"
    },
    {
      // Which notes are being swept, and why. The one to reach for while
      // classifying: a note missing from the overview is a note missing here.
      "caption": "Todos: Show scope",
      "command": "todo_sync_show_scope"
    },
    {
      // Throw away the derived cache and re-read every note in scope.
      "caption": "Todos: Rebuild cache",
      "command": "todo_sync_rebuild"
    },
    {
      "caption": "Convert Office File to Markdown",
      "command": "convert_to_markdown"
    },
        {
      "caption": "Reply to email",
      "command": "reply_to_email"
    },
    {
      "caption": "Email: Browse",
      "command": "browse_emails"
    },
    // {
    //   "caption": "Email: Browse to-reply",
    //   "command": "open_frontmatter_symbol",
    //   "args": { "symbol": "toreply_note", "label": "to-reply", "pick": true }
    // },
    {
      "caption": "Email: Open all to-reply",
      "command": "open_frontmatter_symbol",
      "args": { "symbol": "toreply_note", "label": "to-reply", "pick": false }
    },
    {
      // Review the oldest staged batch from Outlook's ExtractEmailsBatch, or
      // resume one paused with Esc. One panel per email: enter accepts the
      // proposed link, typing picks another, and every decision can be undone
      // until the batch is cleared. The macro starts this by itself; the
      // palette entry is for resuming, and for when Sublime was not running.
      "caption": "Email batch: Review",
      "command": "email_batch_review"
    },
    {
      "caption": "Email: Open original in Outlook",
      "command": "outlook_mail_action",
      "args": { "action": "open" }
    },
    // {
    //   "caption": "Email: Reply in Outlook",
    //   "command": "outlook_mail_action",
    //   "args": { "action": "reply" }
    // },
    // {
    //   "caption": "Email: Reply all in Outlook",
    //   "command": "outlook_mail_action",
    //   "args": { "action": "reply_all" }
    // },
    // {
    //   "caption": "Email: Forward in Outlook",
    //   "command": "outlook_mail_action",
    //   "args": { "action": "forward" }
    // },
    {
      // Touches nothing in Outlook -- the safe probe when a note will not open.
      "caption": "Email: Resolve in Outlook (diagnostic)",
      "command": "outlook_mail_action",
      "args": { "action": "resolve" }
    },
    // The corpus pass -- report, backfill, cleanup -- is no longer a command.
    // It lives in the vault at scripts/resolve_wiki.py; ask the agent to run
    // it. What remains here is diagnostics for the in-editor index.
    {
      // Which person notes the resolver can see, which names collide, and who
      // is flagged 'self: true'. A person missing here is a person the on-save
      // stamp cannot resolve.
      "caption": "Wiki: Show person index",
      "command": "wiki_resolve_show_index"
    },
    {
      // Re-read every person note. Needed when person notes change outside
      // Sublime, since only a save inside the editor refreshes the index.
      "caption": "Wiki: Rebuild person index",
      "command": "wiki_resolve_rebuild_index"
    },
    {
      // Every note linking to this one, straight out of the symbol index: one
      // native lookup, where MarkdownEditing's equivalent reads every .md in
      // the vault. The subject is the note in view, always -- where the caret
      // sits does not change the answer. Also on shift+f12.
      "caption": "Wiki: Show backlinks",
      "command": "wiki_backlinks"
    },
    {
      // The other reading, and the one shift+f12 used to give for free: who
      // ELSE links to the note this [[link]] points at. Deliberately palette
      // only, because as a default it made the panel's subject depend on where
      // the cursor was left, and the panel lists paths without naming what it
      // is about -- so a link mentioned in passing silently answered a
      // question nobody asked. Falls back to the note in view outside a link.
      "caption": "Wiki: Show backlinks to link under caret",
      "command": "wiki_backlinks",
      "args": { "under_caret": true }
    },
    {
      // Rename this note and rewrite every link to it. Locations come from the
      // index, so nothing is searched for; the count in the confirmation is
      // what tells you the index has seen the whole vault. Refuses to run
      // while any affected file has unsaved changes.
      "caption": "Wiki: Rename note and backlinks",
      "command": "wiki_rename_note"
    },
    {
      // Also on ctrl+shift+c.
      "caption": "File: Copy full path",
      "command": "copy_path_to_clipboard"
    },
    {
      "caption": "File: Copy full path with line number",
      "command": "copy_path_to_clipboard",
      "args": { "with_line": true }
    },
    {
      // Run <vault>/scripts/hygiene.py now rather than at the daily tick, and
      // refresh the status-bar item from it.
      "caption": "Hygiene: Check now",
      "command": "hygiene_check"
    },
    {
      // The same run with --all: every hub carrying unreviewed leaves, due or
      // not, in an output panel.
      "caption": "Hygiene: Show full picture",
      "command": "hygiene_show"
    },
    {
      // Toggle "- [?]" <-> "- [-]" on the caret lines. Also on alt+z.
      "caption": "Markers: Dismiss / restore question",
      "command": "marker_toggle_dismiss"
    },
    {
      // Re-open %LOCALAPPDATA%\ClaudeLogs\remindersDue.md, as the SessionStart
      // hook does on a day with reminders due.
      "caption": "Reminders: Show due",
      "command": "open_reminders_due"
    }
]
